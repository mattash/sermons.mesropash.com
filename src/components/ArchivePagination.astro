---
import { archivePageUrl } from "../lib/archive";
import { pageNumbers } from "../lib/archive-presentation";
interface Props { page: number; totalPages: number; basePath?: string }
const { page, totalPages, basePath } = Astro.props;
const pageUrl = (number: number) => basePath ? (number > 1 ? basePath + "page/" + number + "/" : basePath) : archivePageUrl(number);
const linkClass = "archive-page-link";
---
<nav class="archive-pagination" aria-label="Sermon pages" data-pagination data-page-link-class={linkClass} hidden={totalPages <= 1}>
  {page > 1 && <a class={linkClass} href={pageUrl(page - 1)} rel="prev">← Previous</a>}
  {pageNumbers(page, totalPages).map((number) => number === null
    ? <span class="pagination-gap" aria-hidden="true">…</span>
    : <a class={linkClass} href={pageUrl(number)} aria-label={"Page " + number} aria-current={number === page ? "page" : undefined}>{number}</a>)}
  {page < totalPages && <a class={linkClass} href={pageUrl(page + 1)} rel="next">Next →</a>}
</nav>
