---
import { formatSermonDate } from "../lib/sermons";

interface Props {
  entry: {
    id: string;
    data: {
      sermonDate: string;
      title: string;
      preacher: string;
      theme: string | null;
      scriptureReference: string | null;
      liturgicalDay: string | null;
      sermonType: string | null;
      tags: string[];
    };
  };
}

const { entry } = Astro.props;
const { sermonDate, title, preacher, theme, scriptureReference } = entry.data;
---

<article class="border-b border-pine/15 py-8 first:pt-0" data-sermon-card>
  <p class="text-sm font-semibold tracking-wide text-gold" data-card-date>{formatSermonDate(sermonDate)}</p>
  <h2 class="mt-2 text-2xl font-semibold leading-tight text-pine sm:text-3xl">
    <a class="no-underline hover:underline" href={`/sermons/${entry.id}/`} data-card-title>{title}</a>
  </h2>
  <p class="mt-3 text-base text-ink/75" data-card-preacher>{preacher}</p>
  <p class="mt-3 max-w-3xl leading-7 text-ink/80" data-card-theme hidden={!theme}>{theme}</p>
  <p class="mt-3 text-sm italic text-ink/65" data-card-scripture hidden={!scriptureReference}>{scriptureReference}</p>
  <div class="mt-4 border-l-2 border-gold/70 pl-4" data-card-excerpt hidden>
    <p class="text-xs font-semibold tracking-wide text-pine">From the sermon</p>
    <p class="mt-2 text-sm leading-6 text-ink/75" data-card-excerpt-text></p>
  </div>
</article>
