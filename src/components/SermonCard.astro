---
import Icon from "./Icon.astro";
import { compactDate, scripturePreview, summaryPreview } from "../lib/archive-presentation";
interface Props {
  entry: {
    id: string;
    data: {
      sermonDate: string; title: string; preacher: string; theme: string | null;
      scriptureReference: string | null; liturgicalDay: string | null;
      sermonType: string | null; tags: string[];
    };
  };
  topics?: { id: string; label: string }[];
  heading?: "h2" | "h3";
}
const { entry, topics = [], heading: Heading = "h2" } = Astro.props;
const { sermonDate, title, preacher, theme, scriptureReference } = entry.data;
const url = "/sermons/" + entry.id + "/";
---
<article class="sermon-card" data-sermon-card>
  <time class="sermon-card-date" datetime={sermonDate} data-card-date>{compactDate(sermonDate)}</time>
  <div class="sermon-card-content">
    <Heading class="sermon-card-title"><a href={url} data-card-title>{title}</a></Heading>
    <p class="sermon-card-metadata">
      <span data-card-preacher>{preacher}</span>
      <span aria-hidden="true" data-card-scripture-separator hidden={!scriptureReference}> · </span>
      <span title={scriptureReference ?? undefined} data-card-scripture hidden={!scriptureReference}>{scripturePreview(scriptureReference)}</span>
    </p>
    <p class="sermon-card-summary" data-card-theme hidden={!theme}>{summaryPreview(theme)}</p>
    <ul class="sermon-card-topics" data-card-topics hidden={!topics.length}>
      {topics.slice(0, 2).map((topic) => <li><a href={"/topics/" + topic.id + "/"}>{topic.label}</a></li>)}
    </ul>
    <div class="sermon-card-excerpt" data-card-excerpt hidden>
      <p class="sermon-card-excerpt-label">From the sermon</p>
      <p data-card-excerpt-text></p>
    </div>
  </div>
  <a class="sermon-card-open" href={url} aria-label={"Read " + title} data-card-open><Icon name="chevron-right" /></a>
</article>
