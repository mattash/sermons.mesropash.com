---
import type { CollectionEntry } from "astro:content";
import SermonCard from "./SermonCard.astro";
import ArchivePagination from "./ArchivePagination.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import { paginate } from "../lib/archive";
import { createSearchDocuments, filterOptions, MAX_QUERY_LENGTH } from "../lib/search";
import { assignedTopics, getDiscovery } from "../lib/discovery-data";
import { TOPICS } from "../lib/topic-taxonomy";
interface Props { sermons: CollectionEntry<"sermons">[]; page?: number }
const { sermons, page = 1 } = Astro.props;
const result = paginate(sermons, page);
const discovery = getDiscovery(sermons);
const documents = createSearchDocuments(sermons, new Map([...discovery].map(([id, record]) => [id, record.topics.map(({ id }) => id)])));
const options = filterOptions(documents);
const activeTopics = TOPICS.filter(({ id }) => documents.some((doc) => doc.topics.includes(id)));
const shortcuts = ["forgiveness", "prayer", "peace-and-anxiety", "hope-in-suffering", "faith-and-trust", "repentance"]
  .flatMap((id) => activeTopics.find((topic) => topic.id === id) ?? []);
---
<BaseLayout title={page > 1 ? "Page " + page + " | Sermons | Fr. Mesrop Ash" : undefined}>
  <section class="site-shell archive-intro" aria-labelledby="archive-heading">
    <div class="archive-title-row">
      <h1 id="archive-heading">Sermon archive</h1>
      <span class="archive-total">{sermons.length} sermons</span>
    </div>
    <p class="archive-subtitle">St. John Armenian Church</p>

    {sermons.length > 0 && (
      <form class="archive-search" action="/" method="get" role="search" data-sermon-search-form>
        <label class="sr-only" for="sermon-search">Search by topic, Scripture, or a question</label>
        <div class="archive-search-toolbar">
          <div class="archive-search-input">
            <Icon name="search" />
            <input id="sermon-search" name="q" type="search" placeholder="Ask a question, or search topics and Scripture" autocomplete="off" maxlength={MAX_QUERY_LENGTH} aria-controls="sermon-list" aria-describedby="sermon-search-status" />
          </div>
          <button class="archive-search-submit" type="submit">Search</button>
          <button class="archive-filter-toggle" type="button" aria-expanded="false" aria-controls="archive-filters" data-filters-toggle>
            <Icon name="sliders" /><span>Filters</span><span class="filter-count" data-filter-count hidden></span>
          </button>
        </div>
        <div class="archive-filter-panel" id="archive-filters" role="region" aria-label="Filter sermons" data-search-filters hidden>
          <div class="archive-filter-grid">
            <label for="filter-book">Scripture book
              <select id="filter-book" name="book" data-filter="book">
                <option value="">All books</option>
                {options.books.map(({ id, label }) => <option value={id}>{label}</option>)}
              </select>
            </label>
            <label for="filter-chapter">Chapter <span>(optional)</span>
              <input id="filter-chapter" name="chapter" data-filter="chapter" type="number" min="1" max="150" placeholder="Choose a book first" disabled />
            </label>
            <label for="filter-season">Feast or season
              <select id="filter-season" name="season" data-filter="season">
                <option value="">All feasts & seasons</option>
                {options.seasons.map(({ id, label }) => <option value={id}>{label}</option>)}
              </select>
            </label>
            <label for="filter-year">Year
              <select id="filter-year" name="year" data-filter="year">
                <option value="">All years</option>
                {options.years.map((year) => <option value={year}>{year}</option>)}
              </select>
            </label>
            <label for="filter-preacher">Preacher
              <select id="filter-preacher" name="preacher" data-filter="preacher">
                <option value="">All preachers</option>
                {options.preachers.map((preacher) => <option value={preacher}>{preacher}</option>)}
              </select>
            </label>
            <label for="filter-topic">Topic
              <select id="filter-topic" name="topic" data-filter="topic">
                <option value="">All topics</option>
                {activeTopics.map(({ id, label }) => <option value={id}>{label}</option>)}
              </select>
            </label>
          </div>
          <p class="archive-filter-note">Scripture and season filters use the references and liturgical day recorded with each sermon.</p>
        </div>
        <button class="archive-reset" type="button" data-search-reset hidden>Clear search & filters</button>
        <noscript><p class="archive-filter-note">Enable JavaScript to search and filter. You can browse every sermon and topic using the links below.</p></noscript>
      </form>
    )}
    <nav class="archive-topic-shortcuts" aria-label="Explore sermon topics">
      <ul>
        {shortcuts.map((topic) => <li><a class="topic-chip" href={"/topics/" + topic.id + "/"}>{topic.id === "repentance" ? "Repentance" : topic.label}</a></li>)}
      </ul>
      <a class="all-topics-link" href="/topics/">All topics →</a>
    </nav>
  </section>

  <section class="site-shell archive-results" aria-labelledby="sermon-results-heading">
    <div class="archive-results-toolbar">
      <h2 id="sermon-results-heading" data-results-heading>Latest sermons</h2>
      <div class="archive-results-controls">
        <p id="sermon-search-status" role="status" aria-live="polite">{result.start}–{result.end} of {result.total}</p>
        <label class="sr-only" for="archive-sort">Sort sermons</label>
        <select id="archive-sort" class="archive-sort" data-archive-sort>
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="relevance" disabled>Relevance</option>
        </select>
      </div>
    </div>
    {sermons.length > 0 ? (
      <div data-sermon-archive>
        <div id="sermon-list" tabindex="-1" class="sermon-list" data-sermon-list>
          {result.items.map((entry) => <SermonCard entry={entry} topics={assignedTopics(discovery.get(entry.data.archiveId))} heading="h3" />)}
        </div>
        <p class="archive-empty" data-search-empty hidden>No sermons match this search and these filters. Try a broader question or clear a filter.</p>
        <ArchivePagination page={result.page} totalPages={result.totalPages} />
      </div>
    ) : <p class="archive-empty">Finalized sermons will appear here soon.</p>}
  </section>
</BaseLayout>
<script>
  import "../scripts/archive-search";
</script>
