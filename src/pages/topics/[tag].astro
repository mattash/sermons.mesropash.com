---
import { getCollection } from "astro:content";
import TopicArchive from "../../components/TopicArchive.astro";
import { topicRoutes } from "../../lib/discovery-data";

export async function getStaticPaths() {
  return topicRoutes(await getCollection("sermons")).map((topic) => ({ params: { tag: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
---

<TopicArchive topic={topic} />
