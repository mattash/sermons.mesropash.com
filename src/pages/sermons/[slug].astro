---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SermonNavigator from "../../components/SermonNavigator.astro";
import { prepareSermon } from "../../lib/sermon-passages";
import { currentNavigator, type NavigatorPoint, type NavigatorArtifact } from "../../lib/sermon-navigator";
import navigatorArtifact from "../../data/navigators.json";
import { formatSermonDate, videoStartUrl } from "../../lib/sermons";
import { tagUrl } from "../../lib/tags";
import { assignedTopics, getDiscovery } from "../../lib/discovery-data";
import type { DiscoveryRecord } from "../../lib/discovery-core";
import { TOPICS, type TopicId } from "../../lib/topic-taxonomy";

interface Props {
  entry: CollectionEntry<"sermons">;
  discovery: DiscoveryRecord | null;
  html: string;
  points: NavigatorPoint[];
  related: { entry: CollectionEntry<"sermons">; sharedTopics: TopicId[] }[];
}

export async function getStaticPaths() {
  const sermons = await getCollection("sermons");
  const discovery = getDiscovery(sermons);
  const byId = new Map(sermons.map((entry) => [entry.data.archiveId, entry]));
  return Promise.all(sermons.map(async (entry) => {
    const prepared = await prepareSermon(entry.body ?? "");
    return {
    params: { slug: entry.id },
    props: {
      entry, discovery: discovery.get(entry.data.archiveId) ?? null,
      html: prepared.html,
      points: currentNavigator(entry, prepared.passages, navigatorArtifact as NavigatorArtifact),
      related: (discovery.get(entry.data.archiveId)?.related ?? []).map((item) => ({ entry: byId.get(item.archiveId)!, sharedTopics: item.sharedTopics }))
    }
  };
  }));
}

const { entry, discovery, related, html, points } = Astro.props;
const topics = assignedTopics(discovery);
const sermon = entry.data;
const videoUrl = videoStartUrl(sermon.sourceVideoUrl, sermon.startSeconds);
---

<BaseLayout title={`${sermon.title} | Sermons | Fr. Mesrop Ash`} description={sermon.theme ?? sermon.title}>
  <article class:list={["site-shell sermon-page", { "without-navigator": points.length === 0 }]}>
    <header class="sermon-heading">
    <a class="text-sm font-semibold text-pine underline decoration-gold decoration-2" href="/">← All sermons</a>
    <p class="mt-10 text-sm font-semibold tracking-wide text-gold-ink">{formatSermonDate(sermon.sermonDate)}</p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight text-pine sm:text-5xl">{sermon.title}</h1>
    <p class="mt-5 text-lg text-ink/75">{sermon.preacher}</p>
    {sermon.scriptureReference && <p class="mt-3 text-sm italic text-ink/65">{sermon.scriptureReference}</p>}

    <div class="mt-8 border-l-4 border-gold bg-white/55 px-5 py-4 text-base leading-7 text-ink/75">
      <p>{sermon.theme}</p>
    </div>

    <a
      class="mt-8 inline-flex rounded-sm bg-pine px-5 py-3 text-sm font-semibold text-white no-underline transition hover:bg-pine/90"
      href={videoUrl}
      target="_blank"
      rel="noreferrer"
    >
      Watch on YouTube
    </a>

    </header>
    <SermonNavigator points={points} />
    <div class="sermon-text" set:html={html} />
    <div class="sermon-followup">
    {topics.length > 0 && (
      <section class="mt-12 border-t border-pine/15 pt-6">
        <h2 class="text-sm font-semibold tracking-wide text-pine uppercase">Topics</h2>
        <ul class="mt-3 flex flex-wrap gap-2 p-0">
          {topics.map((topic) => (
            <li class="list-none">
              <a
                class="block rounded-full bg-pine/8 px-3 py-1 text-sm text-pine no-underline transition hover:bg-pine/15 hover:underline focus:outline-none focus:ring-2 focus:ring-gold"
                href={`/topics/${topic.id}/`}
              >
                {topic.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-12 border-t border-pine/15 pt-8" aria-labelledby="similar-sermons-heading">
        <h2 class="text-2xl font-semibold text-pine" id="similar-sermons-heading">Explore similar sermons</h2>
        <p class="mt-3 leading-7 text-ink/70">Continue reflecting on the central themes of this sermon.</p>
        <ul class="mt-6 space-y-4 p-0">
          {related.map(({ entry: other, sharedTopics }) => (
            <li class="list-none rounded-sm border border-pine/20 bg-white/55 p-5">
              <p class="text-sm text-gold">{formatSermonDate(other.data.sermonDate)}</p>
              <h3 class="mt-2 text-xl font-semibold leading-snug text-pine"><a class="hover:underline focus:outline-none focus:ring-2 focus:ring-gold" href={`/sermons/${other.id}/`}>{other.data.title}</a></h3>
              <p class="mt-2 text-sm text-ink/65">{other.data.preacher}</p>
              <p class="mt-3 text-sm text-pine">Shared themes: {sharedTopics.slice(0, 3).map((id) => TOPICS.find((topic) => topic.id === id)!.label).join(" · ")}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {sermon.tags.length > 0 && (
      <details class="mt-10 border-t border-pine/15 pt-5 text-sm text-ink/65">
        <summary class="cursor-pointer py-2 text-pine focus:outline-none focus:ring-2 focus:ring-gold">More search keywords & Scripture</summary>
        <ul class="mt-3 flex flex-wrap gap-2 p-0">
          {sermon.tags.map((tag) => <li class="list-none"><a class="block rounded-full bg-pine/8 px-3 py-1 text-pine hover:underline" href={tagUrl(tag)}>{tag}</a></li>)}
        </ul>
      </details>
    )}
    </div>
  </article>
</BaseLayout>

<style>
  .sermon-text :global(p) {
    margin: 1.25rem 0;
  }

  .sermon-text :global(h2),
  .sermon-text :global(h3) {
    color: var(--color-pine);
    font-weight: 600;
    line-height: 1.25;
    margin: 2.5rem 0 1rem;
  }

  .sermon-text :global(a) {
    color: var(--color-pine);
    text-decoration: underline;
  }
</style>
